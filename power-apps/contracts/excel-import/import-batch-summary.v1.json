{
  "contract": "PULSE.PunchExcelImportBatchSummary",
  "version": 1,
  "fields": [
    { "name": "success", "type": "boolean", "nullable": false, "description": "True when the operation completed without a technical failure.", "example": true },
    { "name": "importBatchId", "type": "string", "format": "uuid", "nullable": false, "description": "Server-generated import batch identifier.", "example": "e24103d0-bb8e-47c3-81fb-bb1e54cb2aac" },
    { "name": "status", "type": "string", "nullable": false, "allowedValues": ["CREATED", "STAGED", "VALIDATING", "READY", "BLOCKED", "COMMITTING", "COMMITTED", "CANCELLED", "FAILED", "EXPIRED"], "example": "BLOCKED" },
    { "name": "fileName", "type": "string", "nullable": false, "maxLength": 260, "example": "Punches_4049_20260728.xlsx" },
    { "name": "totalRows", "type": "integer", "nullable": false, "minimum": 0, "example": 2450 },
    { "name": "changedRows", "type": "integer", "nullable": false, "minimum": 0, "example": 231 },
    { "name": "unchangedRows", "type": "integer", "nullable": false, "minimum": 0, "example": 2201 },
    { "name": "validRows", "type": "integer", "nullable": false, "minimum": 0, "example": 2208 },
    { "name": "warningRows", "type": "integer", "nullable": false, "minimum": 0, "example": 11 },
    { "name": "errorRows", "type": "integer", "nullable": false, "minimum": 0, "example": 7 },
    { "name": "conflictRows", "type": "integer", "nullable": false, "minimum": 0, "example": 4 },
    { "name": "appliedRows", "type": "integer", "nullable": false, "minimum": 0, "example": 0 },
    { "name": "failedRows", "type": "integer", "nullable": false, "minimum": 0, "example": 0 },
    { "name": "canCommit", "type": "boolean", "nullable": false, "description": "True only for READY batches without blocking rows.", "example": false },
    { "name": "message", "type": "string", "nullable": false, "maxLength": 2000, "example": "The file was validated with blocking errors." },
    { "name": "errorsJson", "type": "string", "contentType": "application/json", "nullable": false, "example": "[]" }
  ],
  "compatibility": {
    "additiveOptionalFields": "allowed in v1",
    "removedRenamedOrRetypedFields": "requires a new major version"
  }
}
