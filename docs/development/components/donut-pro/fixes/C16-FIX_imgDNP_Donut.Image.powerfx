=With(
    {
        _positiveItems:
            SortByColumns(
                Filter(
                    cmp_DonutPro.Items,
                    Coalesce(Value(SegmentValue), 0) > 0
                ),
                "SegmentOrder",
                SortOrder.Ascending
            ),
        _total:
            Max(
                0.0001,
                cmp_DonutPro.TotalValue
            ),
        _centerText:
            If(
                !IsBlank(cmp_DonutPro.CenterValueText) &&
                !cmp_DonutPro.HasSelection,
                cmp_DonutPro.CenterValueText,
                Text(
                    If(
                        cmp_DonutPro.HasSelection,
                        cmp_DonutPro.SelectedSegmentValue,
                        cmp_DonutPro.TotalValue
                    ),
                    cmp_DonutPro.ValueFormat
                ) &
                cmp_DonutPro.ValueSuffix
            ),
        _centerLabelRaw:
            Upper(
                If(
                    cmp_DonutPro.HasSelection,
                    cmp_DonutPro.SelectedSegmentLabel,
                    cmp_DonutPro.CenterLabel
                )
            )
    },
    With(
        {
            _centerLabel:
                Substitute(
                    Substitute(
                        Substitute(
                            Substitute(
                                If(
                                    Len(_centerLabelRaw) > 18,
                                    Left(_centerLabelRaw, 16) & "…",
                                    _centerLabelRaw
                                ),
                                "&",
                                "&amp;"
                            ),
                            "<",
                            "&lt;"
                        ),
                        ">",
                        "&gt;"
                    ),
                    Char(34),
                    "&quot;"
                ),
            _safeCenterText:
                Substitute(
                    Substitute(
                        Substitute(
                            Substitute(
                                _centerText,
                                "&",
                                "&amp;"
                            ),
                            "<",
                            "&lt;"
                        ),
                        ">",
                        "&gt;"
                    ),
                    Char(34),
                    "&quot;"
                )
        },
        "data:image/svg+xml;utf8," &
        EncodeUrl(
            "<svg viewBox='0 0 190 120' " &
            "xmlns='http://www.w3.org/2000/svg' " &
            "preserveAspectRatio='xMidYMid meet'>" &

            "<circle " &
            "cx='82' cy='60' r='43' " &
            "pathLength='100' " &
            "fill='none' " &
            "stroke='" &
            cmp_DonutPro.TrackColorHex &
            "' " &
            "stroke-width='" &
            Text(
                cmp_DonutPro.DonutThickness,
                "[$-en-US]0.##"
            ) &
            "'/>" &

            Concat(
                Sequence(
                    CountRows(_positiveItems)
                ) As DNPIndex,
                With(
                    {
                        _item:
                            Last(
                                FirstN(
                                    _positiveItems,
                                    DNPIndex.Value
                                )
                            ),
                        _percent:
                            100 *
                            Coalesce(
                                Value(
                                    Last(
                                        FirstN(
                                            _positiveItems,
                                            DNPIndex.Value
                                        )
                                    ).SegmentValue
                                ),
                                0
                            ) /
                            _total,
                        _previousPercent:
                            100 *
                            Sum(
                                FirstN(
                                    _positiveItems,
                                    DNPIndex.Value - 1
                                ),
                                Coalesce(
                                    Value(SegmentValue),
                                    0
                                )
                            ) /
                            _total,
                        _isSelected:
                            cmp_DonutPro.SelectedSegmentKey =
                            Text(
                                Last(
                                    FirstN(
                                        _positiveItems,
                                        DNPIndex.Value
                                    )
                                ).SegmentKey
                            )
                    },
                    With(
                        {
                            _visiblePercent:
                                Max(
                                    0.15,
                                    _percent -
                                    If(
                                        CountRows(
                                            _positiveItems
                                        ) > 1,
                                        cmp_DonutPro.SegmentGapPercent,
                                        0
                                    )
                                )
                        },
                        "<circle " &
                        "cx='82' cy='60' r='43' " &
                        "pathLength='100' " &
                        "fill='none' " &
                        "stroke='" &
                        Coalesce(
                            Text(
                                _item.SegmentColor
                            ),
                            "#64748B"
                        ) &
                        "' " &
                        "stroke-width='" &
                        Text(
                            If(
                                _isSelected,
                                cmp_DonutPro.DonutThickness + 2,
                                cmp_DonutPro.DonutThickness
                            ),
                            "[$-en-US]0.##"
                        ) &
                        "' " &
                        "stroke-dasharray='" &
                        Text(
                            _visiblePercent,
                            "[$-en-US]0.########"
                        ) &
                        " " &
                        Text(
                            100 - _visiblePercent,
                            "[$-en-US]0.########"
                        ) &
                        "' " &
                        "stroke-dashoffset='-" &
                        Text(
                            _previousPercent,
                            "[$-en-US]0.########"
                        ) &
                        "' " &
                        "stroke-linecap='butt' " &
                        "transform='rotate(-90 82 60)' " &
                        "opacity='" &
                        If(
                            cmp_DonutPro.HasSelection &&
                            !_isSelected,
                            "0.48",
                            "1"
                        ) &
                        "'/>"
                    )
                )
            ) &

            "<circle " &
            "cx='82' cy='60' r='31' " &
            "fill='" &
            cmp_DonutPro.CenterFillColorHex &
            "'/>" &

            "<text " &
            "x='82' y='57' " &
            "text-anchor='middle' " &
            "dominant-baseline='middle' " &
            "font-family='Segoe UI,Arial,sans-serif' " &
            "font-size='17' " &
            "font-weight='700' " &
            "fill='" &
            cmp_DonutPro.CenterValueColorHex &
            "'>" &
            _safeCenterText &
            "</text>" &

            "<text " &
            "x='82' y='75' " &
            "text-anchor='middle' " &
            "dominant-baseline='middle' " &
            "font-family='Segoe UI,Arial,sans-serif' " &
            "font-size='7.5' " &
            "font-weight='600' " &
            "letter-spacing='0.5' " &
            "fill='" &
            cmp_DonutPro.CenterLabelColorHex &
            "'>" &
            _centerLabel &
            "</text>" &

            If(
                cmp_DonutPro.HasSelection,
                "<text " &
                "x='82' y='88' " &
                "text-anchor='middle' " &
                "dominant-baseline='middle' " &
                "font-family='Segoe UI,Arial,sans-serif' " &
                "font-size='7' " &
                "fill='" &
                cmp_DonutPro.CenterLabelColorHex &
                "'>" &
                Text(
                    cmp_DonutPro.SelectedPercentage,
                    cmp_DonutPro.PercentageFormat
                ) &
                "</text>",
                ""
            ) &

            "</svg>"
        )
    )
)