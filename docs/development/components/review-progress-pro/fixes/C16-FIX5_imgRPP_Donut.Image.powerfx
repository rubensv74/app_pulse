=With(
    {
        _total: Max(0, Coalesce(cmp_ReviewProgressPro.TotalCount, 0)),
        _reviewed:
            Min(
                Max(0, Coalesce(cmp_ReviewProgressPro.ReviewedCount, 0)),
                Max(0, Coalesce(cmp_ReviewProgressPro.TotalCount, 0))
            )
    },
    With(
        {
            _pct: If(_total <= 0, 0, _reviewed / _total),
            _angle:
                -1.5707963267948966 +
                (6.283185307179586 * If(_total <= 0, 0, _reviewed / _total))
        },
        With(
            {
                _endX: 50 + (32 * Cos(_angle)),
                _endY: 50 + (32 * Sin(_angle)),
                _largeArc: If(_pct > 0.5, "1", "0")
            },
            "data:image/svg+xml;utf8," &
            EncodeUrl(
                "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>" &

                "<circle cx='50' cy='50' r='32' fill='none' stroke='" &
                cmp_ReviewProgressPro.RemainingColorHex &
                "' stroke-width='18'/>" &

                If(
                    _pct <= 0,
                    "",
                    If(
                        _pct >= 0.9999,
                        "<circle cx='50' cy='50' r='32' fill='none' stroke='" &
                        cmp_ReviewProgressPro.ReviewedColorHex &
                        "' stroke-width='18'/>",
                        "<path d='M 50 18 A 32 32 0 " &
                        _largeArc &
                        " 1 " &
                        Text(_endX, "[$-en-US]0.####") &
                        " " &
                        Text(_endY, "[$-en-US]0.####") &
                        "' fill='none' stroke='" &
                        cmp_ReviewProgressPro.ReviewedColorHex &
                        "' stroke-width='18' stroke-linecap='butt'/>"
                    )
                ) &

                "<circle cx='50' cy='50' r='22' fill='" &
                cmp_ReviewProgressPro.CenterFillColorHex &
                "'/>" &

                "<text x='50' y='47' text-anchor='middle' dominant-baseline='middle' font-family='Segoe UI,Arial,sans-serif' font-size='17' font-weight='700' fill='#0F172A'>" &
                Text(_total, "[$-en-US]#,##0") &
                "</text>" &

                "<text x='50' y='63' text-anchor='middle' dominant-baseline='middle' font-family='Segoe UI,Arial,sans-serif' font-size='7.5' font-weight='600' fill='#64748B'>TOTAL</text>" &
                "</svg>"
            )
        )
    )
)