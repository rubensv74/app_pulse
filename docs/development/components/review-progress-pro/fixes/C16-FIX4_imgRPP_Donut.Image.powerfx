=With(
    {
        _total:
            Max(
                0,
                Coalesce(cmp_ReviewProgressPro.TotalCount, 0)
            ),
        _reviewedDash:
            100 * cmp_ReviewProgressPro.ReviewedPercentage
    },
    "data:image/svg+xml;utf8," &
    EncodeUrl(
        "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>" &
        "<circle cx='50' cy='50' r='32' pathLength='100' fill='none' stroke='" &
        cmp_ReviewProgressPro.RemainingColorHex &
        "' stroke-width='18'/>" &
        If(
            _reviewedDash > 0,
            "<circle cx='50' cy='50' r='32' pathLength='100' fill='none' stroke='" &
            cmp_ReviewProgressPro.ReviewedColorHex &
            "' stroke-width='18' stroke-dasharray='" &
            Text(
                _reviewedDash,
                "[$-en-US]0.####"
            ) &
            " " &
            Text(
                100 - _reviewedDash,
                "[$-en-US]0.####"
            ) &
            "' stroke-linecap='butt' transform='rotate(-90 50 50)'/>",
            ""
        ) &
        "<circle cx='50' cy='50' r='22' fill='" &
        cmp_ReviewProgressPro.CenterFillColorHex &
        "'/>" &
        "<text x='50' y='47' text-anchor='middle' dominant-baseline='middle' font-family='Segoe UI,Arial,sans-serif' font-size='17' font-weight='700' fill='#0F172A'>" &
        Text(
            _total,
            "[$-en-US]#,##0"
        ) &
        "</text>" &
        "<text x='50' y='63' text-anchor='middle' dominant-baseline='middle' font-family='Segoe UI,Arial,sans-serif' font-size='7.5' font-weight='600' fill='#64748B'>TOTAL</text>" &
        "</svg>"
    )
)
