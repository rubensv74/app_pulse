// =====================================================
// App.OnStart
// APP-START-01 — organized global bootstrap
// PENDING POWER APPS STUDIO VALIDATION
// =====================================================

// -----------------------------------------------------
// 01) Runtime / responsive layout
// -----------------------------------------------------
Set(varProjectSwitching, false);
Set(varW, App.Width);
Set(varH, App.Height);
Set(varRatio, varW / varH);
Set(varCompactMode, App.Height < 850);
Set(varBp, If(varW < 900, "S", If(varW < 1400, "M", "L")));
Set(varBpH, If(varH < 700, "S", If(varH < 900, "M", "L")));
Set(varFontBase, Switch(varBp, "S", 12, "M", 13, "L", 14, 13));
Set(varH_Header, Switch(varBp, "S", 52, "M", 56, "L", 56, 56));
Set(varH_Filters, Switch(varBp, "S", 104, "M", 88, "L", 88, 88));
Set(varH_Status, 32);
Set(varPad, Switch(varBp, "S", 10, "M", 12, "L", 12, 12));
Set(varGap, Switch(varBp, "S", 8, "M", 10, "L", 10, 10));

// -----------------------------------------------------
// 02) Drawer responsive
// -----------------------------------------------------
Set(varDrawerMode, If(varW < 1100 || varH < 750, "Overlay", "Side"));
Set(varDrawerMaxW, Switch(varDrawerMode, "Side", 640, "Overlay", Min(900, RoundDown(varW * 0.92, 0)), 640));
Set(varDrawerMaxH, Switch(varDrawerMode, "Side", varH - varH_Header - varPad * 2, "Overlay", Min(820, RoundDown(varH * 0.9, 0)), varH - varH_Header - varPad * 2));

// -----------------------------------------------------
// 03) Global visual tokens
// -----------------------------------------------------
Set(
    gblAppColors,
    {
        Primary: RGBA(95, 121, 151, 1),
        PrimaryDark: RGBA(75, 95, 120, 1),
        Background: RGBA(245, 247, 250, 1),
        Surface: RGBA(255, 255, 255, 1),
        Border: RGBA(0, 0, 0, 0.08),
        TextPrimary: RGBA(30, 30, 30, 1),
        TextSecondary: RGBA(100, 100, 100, 1),
        Success: RGBA(24, 130, 84, 1),
        Warning: RGBA(194, 120, 3, 1),
        Danger: RGBA(200, 60, 60, 1),
        TagBg: RGBA(95, 121, 151, 0.1)
    }
);
Set(varTheme_NavBg, ColorValue("#07111F"));
Set(varTheme_NavBg2, ColorValue("#0B1220"));
Set(varTheme_TopBg, ColorValue("#FFFFFF"));
Set(varTheme_PageBg, ColorValue("#F6F8FB"));
Set(varTheme_Surface, ColorValue("#FFFFFF"));
Set(varTheme_SurfaceAlt, ColorValue("#F8FAFC"));
Set(varTheme_Border, ColorValue("#E2E8F0"));
Set(varTheme_Text, ColorValue("#0F172A"));
Set(varTheme_TextMuted, ColorValue("#64748B"));
Set(varTheme_TextSoft, ColorValue("#94A3B8"));
Set(varTheme_TextWhite, ColorValue("#FFFFFF"));
Set(varTheme_PulseBlue, ColorValue("#00C8FF"));
Set(varTheme_PulseBlueDark, ColorValue("#1677FF"));
Set(varTheme_PulseSoft, ColorValue("#E0F7FF"));
Set(varTheme_Green, ColorValue("#22C55E"));
Set(varTheme_Amber, ColorValue("#F59E0B"));
Set(varTheme_Red, ColorValue("#EF4444"));
Set(varTheme_CardRadius, 16);
Set(varTheme_ButtonRadius, 10);

// -----------------------------------------------------
// 04) User / session
// SECURITY TODO: replace hardcoded manager with authoritative role source.
// -----------------------------------------------------
Set(varUserEmail, Lower(User().Email));
Set(varUserName, User().FullName);
Set(varUserRole, "manager");
Set(varCurrentUserEmail, varUserEmail);
Set(varCurrentUserName, varUserName);
Set(varIsSuperAdmin, false);
Set(varSA_IsSuperAdminText, "0");

// -----------------------------------------------------
// 05) Navigation / page defaults
// -----------------------------------------------------
Set(gblNavKey, "Home");
Set(varAppView, "Home");
Set(varSelectedKey, "Home");
Set(varAppViewPrev, "Home");
Set(varHomeViewMode, "DASHBOARD");
Set(varOps_ViewMode, "OVERVIEW");
Set(varOps_QuickFilter, "ALL");
Set(varPageKey, "HOME");
Set(varPageTitle, "Home");
Set(varPageSubtitle, "Project command center");

// -----------------------------------------------------
// 06) Project context
// -----------------------------------------------------
Set(varProjectId, Blank());
Set(varProjectCode, "");
Set(varProjectName, "");
Set(varProjectDescription, "");
Set(varSelectedProject, Blank());
Set(varProjectLoaded, false);
Set(varApplySubsystemDefault, false);

// -----------------------------------------------------
// 07) Global security
// -----------------------------------------------------
Clear(colSecurity);
IfError(
    ClearCollect(colSecurity, WarRoom_Security_IsSuperAdmin.Run(varCurrentUserEmail)),
    ClearCollect(colSecurity, {issuperadmin: "0"})
);
Set(varSA_IsSuperAdminText, Coalesce(Text(First(colSecurity).issuperadmin), "0"));
Set(varIsSuperAdmin, varSA_IsSuperAdminText = "1");

// -----------------------------------------------------
// 08) Enabled projects
// -----------------------------------------------------
Clear(colEnabledProjectsRaw);
Clear(colEnabledProjects);
Clear(colEnabledProjectsUI);
Set(varEnabledProjectsError, "");
IfError(
    Set(varEnabledProjectsRaw, WarRoom_EnabledProjects_GetActive.Run().result),
    Set(varEnabledProjectsError, FirstError.Message);
    Set(varEnabledProjectsRaw, "{}")
);
If(
    IsBlank(varEnabledProjectsError),
    ClearCollect(
        colEnabledProjects,
        ForAll(
            Table(ParseJSON(Coalesce(varEnabledProjectsRaw, "{}")).Table1),
            {
                ProjectId: Value(Value.ProjectId),
                ProjectCode: Text(Value.ProjectCode),
                ProjectName: Text(Value.ProjectName),
                ProjectDescription: Text(Value.ProjectDescription),
                IsDefault: Boolean(Value.IsDefault)
            }
        )
    )
);
ClearCollect(
    colEnabledProjectsUI,
    AddColumns(colEnabledProjects, ProjectDisplayName, ProjectCode & " · " & ProjectName)
);

// -----------------------------------------------------
// 09) Sidebar navigation
// -----------------------------------------------------
ClearCollect(
    colSidebarNavItems,
    {Order: 10, Key: "Home", Label: "Home", IconKey: "home"},
    {Order: 20, Key: "overview", Label: "Overview", IconKey: "overview"},
    {Order: 30, Key: "punchreview", Label: "Punch Review", IconKey: "punch-review"},
    {Order: 40, Key: "Punches", Label: "Punch List", IconKey: "punch-list"},
    {Order: 41, Key: "Briefing", Label: "Briefing", IconKey: "briefing"},
    {Order: 42, Key: "Skyline", Label: "Skyline", IconKey: "skyline"},
    {Order: 50, Key: "Config", Label: "Config", IconKey: "config"}
);
If(varIsSuperAdmin, Collect(colSidebarNavItems, {Order: 90, Key: "SuperAdmin", Label: "Admin", IconKey: "admin"}));

