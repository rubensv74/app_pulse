{
  "contract": "PULSE.PunchExcelExportColumns",
  "version": 1,
  "flow": "Warroom_ExportPunchesToExcel",
  "parameter": "SelectedColumnsJson",
  "technicalColumns": [
    { "columnKey": "ExportBatchId", "columnLabel": "ExportBatchId", "sortOrder": -700, "editable": false, "required": true },
    { "columnKey": "ProjectId", "columnLabel": "ProjectId", "sortOrder": -600, "editable": false, "required": true },
    { "columnKey": "TemplateId", "columnLabel": "TemplateId", "sortOrder": -500, "editable": false, "required": true },
    { "columnKey": "WorkItemId", "columnLabel": "WorkItemId", "sortOrder": -400, "editable": false, "required": true },
    { "columnKey": "RowVersion", "columnLabel": "RowVersion", "sortOrder": -300, "editable": false, "required": true },
    { "columnKey": "ExportedAtUtc", "columnLabel": "ExportedAtUtc", "sortOrder": -200, "editable": false, "required": true },
    { "columnKey": "RowChecksum", "columnLabel": "RowChecksum", "sortOrder": -100, "editable": false, "required": true }
  ],
  "rules": {
    "technicalColumnsAreAlwaysIncluded": true,
    "technicalColumnsAreNotUserSelectable": true,
    "technicalColumnsMustBeProtectedInExcel": true,
    "backendMustValidateAgainstStoredExportBatch": true,
    "rowVersionEncoding": "uppercase hexadecimal, 16 characters",
    "rowChecksumAlgorithm": "SHA-256 over backend canonical row representation",
    "exportBatchIdEncoding": "UUID"
  }
}
