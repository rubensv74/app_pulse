{
  "contract": "PULSE.PunchExcelExportColumns",
  "version": 3,
  "flow": "Warroom_ExportPunchesToExcel_Codex",
  "compatibility": {
    "previousVersion": 2,
    "classification": "breaking",
    "reason": "The workbook now emits the canonical I01 import metadata names while retaining legacy physical fields as hidden compatibility columns."
  },
  "technicalColumns": [
    { "columnKey": "ExportBatchId", "type": "string", "format": "uuid", "nullable": false, "editable": false, "required": true, "example": "5f26d91c-184f-4aa2-bf9e-c98de56c7374", "validation": "Technical GUID returned by snapshot registration; must reference warroom.ExportBatch." },
    { "columnKey": "PunchExportLogId", "type": "integer", "nullable": false, "editable": false, "required": true, "example": 4812, "validation": "Functional export-attempt identifier; unique in warroom.ExportBatch." },
    { "columnKey": "ProjectId", "type": "integer", "nullable": false, "editable": false, "required": true, "example": 4049, "validation": "One value per file; must match warroom.ExportBatch." },
    { "columnKey": "TemplateId", "type": "integer", "nullable": false, "editable": false, "required": true, "example": 12, "validation": "One value per import file and must match every imported work item." },
    { "columnKey": "WorkItemId", "type": "integer", "nullable": false, "editable": false, "required": true, "example": 100234, "validation": "Unique in file and present in warroom.ExportBatchRow." },
    { "columnKey": "RowVersion", "type": "string", "nullable": true, "editable": false, "required": false, "maxLength": 16, "example": "", "validation": "Reserved until the source Punch table exposes binary rowversion." },
    { "columnKey": "ExportedAtUtc", "type": "datetime", "nullable": false, "editable": false, "required": true, "example": "2026-07-29T08:30:00Z", "validation": "ISO 8601 UTC; must match export information." },
    { "columnKey": "RowChecksum", "type": "string", "nullable": false, "editable": false, "required": true, "maxLength": 64, "example": "A1B2C3D4E5F6...", "validation": "Uppercase SHA-256; must match warroom.ExportBatchRow.RowChecksum." }
  ],
  "legacyHiddenColumns": [
    { "columnKey": "PunchId", "canonicalColumn": "WorkItemId" },
    { "columnKey": "RowHash", "canonicalColumn": "RowChecksum" },
    { "columnKey": "Original Row Hash", "canonicalColumn": "RowChecksum" }
  ],
  "concurrency": {
    "mechanism": "canonical SHA-256 checksum",
    "canonicalSource": "OriginalValuesJson generated by warroom.usp_ExportProjectPunchesExtended_Pivoted",
    "includes": "All exported standard fields plus sorted dynamic custom-field values.",
    "conflictRule": "Recompute the current canonical checksum and compare with the immutable ExportBatchRow.RowChecksum."
  },
  "selection": {
    "technicalColumnsAreOwnedByOfficeScript": true,
    "powerAppsMustNotAppendTechnicalColumns": true,
    "businessAllowlistIsSnapshotted": true
  }
}
