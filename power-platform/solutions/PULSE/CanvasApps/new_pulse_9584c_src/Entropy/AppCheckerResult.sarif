          "properties": {
            "level": "Medium"
          },
          "ruleId": "app-IndexedAccessViaCopy",
          "ruleIndex": 19
        }
      ],
      "tool": {
        "driver": {
          "fullName": "PowerApps app checker",
          "name": "PowerApps app checker",
          "rules": [
            {
