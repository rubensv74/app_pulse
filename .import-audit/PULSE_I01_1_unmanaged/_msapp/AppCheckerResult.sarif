ualifiedName":"scr_Overview.btnPHR_Search_Overview.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"scr_Overview.btnPHR_Search_Overview.OnSelect"}],"properties":{"module":"scr_Overview","type":"scr_Overview.btnPHR_Search_Overview","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CrossScreenEventDependencies","ruleIndex":16,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"scr_Tasks.conTasksScreenRoot.conTasksContent.con_TasksRoot.conMain_1.conTasks_ListPanel_1.conTasksGrid_2.galTasks_1.'74b2d816-ce79-408f-9f88-8f96eddfd59e'.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"scr_Tasks.conTasksScreenRoot.conTasksContent.con_TasksRoot.conMain_1.conTasks_ListPanel_1.conTasksGrid_2.galTasks_1.'74b2d816-ce79-408f-9f88-8f96eddfd59e'.OnSelect"}],"properties":{"module":"scr_Tasks","type":"scr_Tasks.conTasksScreenRoot.conTasksContent.con_TasksRoot.conMain_1.conTasks_ListPanel_1.conTasksGrid_2.galTasks_1.'74b2d816-ce79-408f-9f88-8f96eddfd59e'","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CrossScreenEventDependencies","ruleIndex":16,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"scr_Punches.conPunchesScreenRoot.conPunchesContent.con_PunchesRoot.conMain_Punches_1.conPunches_ListPanel_1.conTasksGrid_3.galPunches_1.'0ba31d11-9d9c-4a07-91cc-91c958df2f72'.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"scr_Punches.conPunchesScreenRoot.conPunchesContent.con_PunchesRoot.conMain_Punches_1.conPunches_ListPanel_1.conTasksGrid_3.galPunches_1.'0ba31d11-9d9c-4a07-91cc-91c958df2f72'.OnSelect"}],"properties":{"module":"scr_Punches","type":"scr_Punches.conPunchesScreenRoot.conPunchesContent.con_PunchesRoot.conMain_Punches_1.conPunches_ListPanel_1.conTasksGrid_3.galPunches_1.'0ba31d11-9d9c-4a07-91cc-91c958df2f72'","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":10,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"scr_SuperAdmin.conSuperAdminScreenRoot.conSuperAdminContent.con_SuperAdminRoot.conSA_Projects_1.btnSA_SearchProjects_1.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"scr_SuperAdmin.conSuperAdminScreenRoot.conSuperAdminContent.con_SuperAdminRoot.conSA_Projects_1.btnSA_SearchProjects_1.OnSelect"}],"properties":{"module":"scr_SuperAdmin","type":"scr_SuperAdmin.conSuperAdminScreenRoot.conSuperAdminContent.con_SuperAdminRoot.conSA_Projects_1.btnSA_SearchProjects_1","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":10,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"scr_SuperAdmin.conSuperAdminScreenRoot.conSuperAdminContent.con_SuperAdminRoot.conSA_Projects_1.galSA_ProjectSearch_1.btnSA_EnableProject_1.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"scr_SuperAdmin.conSuperAdminScreenRoot.conSuperAdminContent.con_SuperAdminRoot.conSA_Projects_1.galSA_ProjectSearch_1.btnSA_EnableProject_1.OnSelect"}],"properties":{"module":"scr_SuperAdmin","type":"scr_SuperAdmin.conSuperAdminScreenRoot.conSuperAdminContent.con_SuperAdminRoot.conSA_Projects_1.galSA_ProjectSearch_1.btnSA_EnableProject_1","member":"OnSelect"}}],"properties":{"level":"Medium"}}],"tool":{"driver":{"name":"PowerApps app checker","fullName":"PowerApps app checker","version":"1.349","rules":[{"id":"app-ErrInvalidName","messageStrings":{"issue":{"text":"Name isn't valid. '{0}' isn't recognized."}},"properties":{"howToFix":["Remove or correct the reference to the name that isn't valid."],"whyFix":"","level":"High","componentType":"app","primaryCategory":"formula"}},{"id":"app-ErrInvalidArgs-Func","messageStrings":{"issue":{"text":"The function '{0}' has some invalid arguments."}},"properties":{"whyFix":"","level":"High","componentType":"app","primaryCategory":"formula"}},{"id":"app-ErrIncompatibleTypesForEquality-Left-Right","messageStrings":{"issue":{"text":"Incompatible types for comparison. These types can't be compared: {0}, {1}."}},"properties":{"howToFix":["You might need to convert the value to be the same type, such as converting a date string (e.g., \"12/31/2018\") to a date value.","If you're comparing records or tables, the field or column types must match exactly."],"whyFix":"","level":"High","componentType":"app","primaryCategory":"formula"}},{"id":"app-ErrIncorrectFormat-Func","messageStrings":{"issue":{"text":"Incorrect format specifier for '{0}'."}},"properties":{"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-ErrFunctionExpectsSameScreenForSelect","messageStrings":{"issue":{"text":"Select of a control that is not on this screen."}},"properties":{"whyFix":"","level":"High","componentType":"app","primaryCategory":"formula"}},{"id":"app-ErrTypeError","messageStrings":{"issue":{"text":"Incompatible type. We can't evaluate your formula because of a type error."}},"properties":{"howToFix":["Check the types of the values involved in the formula and ensure the types match."],"whyFix":"","level":"High","componentType":"app","primaryCategory":"formula"}},{"id":"acc-AccessibleLabelNeeded","messageStrings":{"issue":{"text":"Missing accessible label"}},"properties":{"howToFix":["Edit the accessible label property to describe the item."],"whyFix":"If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-TabIndexShouldBeDefinedForInteractiveControl","messageStrings":{"issue":{"text":"Missing tab stop"}},"properties":{"howToFix":["Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."],"whyFix":"People who use the keyboard with your app will not be able to access this element without a tab stop.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-StateIndicationTextNeeded","messageStrings":{"issue":{"text":"Add State indication text"}},"properties":{"howToFix":["Set ShowValue = true to show the current state of the control."],"whyFix":"Users won't get confirmation of their actions if the state of the control isn't showing.","level":"Low","componentType":"app","primaryCategory":"accessibility"}},{"id":"app-UnusedVariables","messageStrings":{"issue":{"text":"Unused variable"}},"properties":{"howToFix":["Remove the unused variable."],"whyFix":"This variable is declared but is not referenced by any control, so it is not needed.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ForAllWithMutation","messageStrings":{"issue":{"text":"Mutating a collection or data source inside ForAll may trigger excessive rule re-evaluation"}},"properties":{"howToFix":["Since ForAll returns a table, pass its result as input to the mutation function in a single batched call. For example, replace ForAll(source, Collect(c, { ... })) with Collect(c, ForAll(source, { ... })); the same pattern applies to Patch and Remove. A single batched mutation emits one change notification instead of one per iteration.","For trivial per-row updates or deletions against a data source, prefer the delegable UpdateIf or RemoveIf functions called once outside ForAll instead of iterating with ForAll."],"whyFix":"Using Collect, Patch, Remove, or another mutation function inside the body of ForAll mutates the target collection or data source once per iteration. Every control property that depends on that collection or data source re-evaluates on each mutation, which can turn a small loop into thousands of rule evaluations and, for connected data sources, a network request per row.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CollectingReadOnlyTable","messageStrings":{"issue":{"text":"Collection is initialized but never updated"}},"properties":{"howToFix":["Replace the Collect or ClearCollect with a named formula on App.Formulas. For example, MyTable = Filter(source, condition). Named formulas are computed when their inputs change and do not carry the tracking cost of a collection."],"whyFix":"Collections are meant to be updated. Power Apps does extra work to keep track of every collection so that anything depending on it stays in sync when the data changes. When the data never changes after it is set, that tracking work is wasted. A named formula gives the same data without the extra cost.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CountRowsGalleryAllItems","messageStrings":{"issue":{"text":"Use AllItemsCount instead of CountRows with AllItems"}},"properties":{"howToFix":["Replace CountRows(Gallery.AllItems) with Gallery.AllItemsCount for better performance."],"whyFix":"Using CountRows with a gallery's AllItems property forces the creation of an output table containing a copy of the input data source and the current state of all child controls. This may force uninitialized rows to be initialized, consuming additional CPU cycles, memory, and potentially triggering row-level network requests.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ScreenHasManyControls","messageStrings":{"issue":{"text":"Too many controls on a screen"}},"properties":{"howToFix":["Reduce the number of controls on the screen.","Break the app into more screens to reduce the per-screen complexity.","Use components to unify grouped controls that are identical across screens, reducing duplication.","Use galleries to represent a series of repeated similar controls.","Break the app into multiple apps so that each app is small and performant."],"whyFix":"Each control consumes resources, and an app may become slow or unresponsive if a screen has too many controls. The estimated complexity of \"scr_Home\" is 348, which exceeds the maximum threshold recommended (300).","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-InefficientDelayLoading","messageStrings":{"issue":{"text":"Inefficient delay loading"}},"properties":{"howToFix":["Use variables, collections, and navigation context to share state across screens instead."],"whyFix":"Controls that reference controls on other screens can slow down app loading and navigation. Doing this may force the app to load the other screens immediately, rather than waiting until the user navigates to that screen.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-IndexedAccessViaCopy","messageStrings":{"issue":{"text":"Use Index to read a record at a given position"}},"properties":{"howToFix":["Replace Last(FirstN(t, n)) with Index(t, Min(CountRows(t), n)) — t and n stay the same as in your original expression. The Min keeps the original behavior — when n is in range it returns the n-th row, and when n is larger than the row count it returns the last row instead of an error. If you already know that n is between 1 and CountRows(t), you can simplify to Index(t, n).","Replace First(LastN(t, n)) with Index(t, Max(1, CountRows(t) - n + 1)) — t and n stay the same as in your original expression. The Max keeps the original behavior — when n is in range it returns the n-th-from-end row, and when n is larger than the row count it returns the first row instead of an error. If you already know that n is between 1 and CountRows(t), you can simplify to Index(t, CountRows(t) - n + 1)."],"whyFix":"In expressions like Last(FirstN(t, n)) and First(LastN(t, n)) — where t is the table and n is the row position — both forms materialize a copy of the table up to n rows just to return one record at the boundary. Index(t, ...) returns the record at a position directly without building the intermediate copy, avoiding the copy cost and any per-row work the copy would trigger. When n is between 1 and the row count of t (identifiers t and n should stay the same as in your original expression), the two forms return the same record; when n exceeds the row count Index errors while the FirstN/LastN forms clamp to a boundary row, so use a clamping formula such as Min(CountRows(t), n) if your data may be smaller than n.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CrossScreenEventDependencies","messageStrings":{"issue":{"text":"Event rule references a control on another screen"}},"properties":{"howToFix":["Move the work to an event on the owning screen (for example, Screen.OnVisible), or pass state between screens using Navigate's context parameter or a global variable and react to it on the target screen."],"whyFix":"Event rules (such as OnStart, OnVisible, and OnSelect) that reference controls on other screens force those screens to load and initialize early, even if the user never navigates to them. This can noticeably slow app start-up and navigation.","componentType":"app","primaryCategory":"performance","level":"Medium"}}]}},"invocations":[{"executionSuccessful":true}],"columnKind":"utf16CodeUnits"}]}